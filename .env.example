# Kopieren nach .env und Werte setzen. .env wird nie committet.

# --- Server und lokal ---
LERN_API_TOKEN=

# --- nur Server ---
LERN_PASSWORT=
LERN_SECRET=
LERN_PORT=8099
# Nur für lokale Entwicklung ohne HTTPS auf 0 setzen:
LERN_COOKIE_SECURE=1

# --- nur lokal: Adresse des Servers (Standard http://localhost:8099) ---
# LERN_URL=https://lernen.example.com
